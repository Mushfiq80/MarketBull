# ---------------------------------------------------------------------------
# BABull environment. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=babull
POSTGRES_PASSWORD=change_me
POSTGRES_DB=babull
POSTGRES_PORT=5432
DATABASE_URL=postgresql://babull:change_me@localhost:5432/babull

# --- Quant service --------------------------------------------------------
# Shared secret between the web server and the Python service.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUANT_SERVICE_TOKEN=change_me_to_a_long_random_string
QUANT_SERVICE_URL=http://127.0.0.1:8000
QUANT_BIND_HOST=127.0.0.1
QUANT_BIND_PORT=8000

# --- Storage --------------------------------------------------------------
# Raw source snapshots, documents, model artifacts.
# Local filesystem in development; S3-compatible later.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# --- LLM provider ---------------------------------------------------------
# Provider abstraction: one of `anthropic` | `openai` | `none`.
# `none` disables the research-chat surface; the rest of the product works.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_EMBEDDING_MODEL=
# Embedding dimension must match the `vector(N)` column in the schema.
LLM_EMBEDDING_DIM=1536

# --- Ingestion ------------------------------------------------------------
# Be a good citizen against public pages.
INGEST_USER_AGENT=BABull/0.1 (private research; contact: you@example.com)
INGEST_REQUEST_DELAY_MS=1500
INGEST_MAX_RETRIES=3
INGEST_TIMEOUT_SECONDS=30

# Source base URLs — overridable so a change of path does not need a code edit.
DSE_BASE_URL=https://www.dse.com.bd
BSEC_BASE_URL=https://sec.gov.bd
BB_BASE_URL=https://www.bb.org.bd
BBS_BASE_URL=https://bbs.gov.bd

# --- App ------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=BABull
NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Dhaka
# Single-operator mode: skips auth for local R&D. Set to `false` before exposing.
SINGLE_OPERATOR_MODE=true
LOG_LEVEL=info
