# ---------------------------------------------------------------------------
# BABull — repository ignore rules
# ---------------------------------------------------------------------------

# Internal documentation, design skills and working notes (kept local only)
babull-docs/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Next.js
.next/
out/
build/
dist/
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data — never commit market data, snapshots or documents
data/
storage/
snapshots/
*.sqlite
*.db
*.duckdb

# Logs
*.log
npm-debug.log*
yarn-error.log*
logs/

# Testing / coverage
coverage/
.nyc_output/
htmlcov/
.coverage

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Misc
.turbo/
.cache/
tsconfig.tsbuildinfo
